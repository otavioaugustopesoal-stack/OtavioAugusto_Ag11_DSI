from colorama import init, Fore, Style

# Inicializa o colorama para restaurar o estilo automaticamente se necessário
init()

# 1. Lista para armazenar os níveis e situações do reservatório
niveis_agua = [
    {"nivel": 1, "situacao": "Muito baixo (crítico)"},
    {"nivel": 2, "situacao": "Baixo"},
    {"nivel": 3, "situacao": "Médio"},
    {"nivel": 4, "situacao": "Alto"},
    {"nivel": 5, "situacao": "Muito alto (alerta)"}
]

# 2. Função responsável por definir a cor da mensagem conforme o nível
def obter_cor(nivel):
    if nivel == 1:
        return Fore.RED
    elif nivel == 2:
        return Fore.YELLOW
    elif nivel == 3:
        return Fore.GREEN
    elif nivel == 4:
        return Fore.CYAN
    elif nivel == 5:
        return Fore.BLUE
    else:
        return Fore.WHITE

# 3. Procedimento para simular o monitoramento e exibir no terminal
def simular_monitoramento():
    print("==========================================")
    print("  PAINEL DE CONTROLE DE NÍVEIS DE ÁGUA    ")
    print("==========================================\n")

    for item in niveis_agua:
        nivel = item["nivel"]
        situacao = item["situacao"]
        cor = obter_cor(nivel)
        
        # Exibe a mensagem colorida e restaura o estilo padrão do terminal
        print(f"{cor}Nível {nivel} - Situação: {situacao}{Style.RESET_ALL}")
    
    print("\n==========================================")

# Execução do programa
if __name__ == "__main__":
    simular_monitoramento()